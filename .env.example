# Copy to .env.local. Never commit real values; on Vercel set the same names in the project settings.
# Each group is checked when its feature is first used: a missing name makes that feature answer 500 and the log names it.

# Contact form
RESEND_API_KEY=
ADMIN_EMAIL=
# Sender; the domain must be verified in Resend. e.g. Contact <contact@your-domain.example>
CONTACT_MAIL_FROM=

# Decap CMS sign-in (GitHub OAuth App callback URL: <site>/api/decap-oauth/callback)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
